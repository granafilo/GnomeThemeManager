<!-- Declarative template for 'Current Status' page with 4-state GtkStack -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="GtkStack" id="page_root">
    <property name="transition-type">crossfade</property>
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>

    <!-- 1. LOADING State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">loading</property>
        <property name="child">
          <object class="AdwStatusPage" id="loading_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">preferences-desktop-theme-symbolic</property>
            <property name="title" translatable="yes">Loading...</property>
            <property name="description" translatable="yes">Retrieving current theme state and system diagnostics.</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="spinning">true</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
                <property name="margin-top">12</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 2. READY State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkBox" id="ready_box">
            <property name="orientation">vertical</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>

            <!-- Info banner for warnings -->
            <child>
              <object class="AdwBanner" id="banner_warning">
                <property name="revealed">false</property>
              </object>
            </child>

            <!-- Preferences page with native scrolling -->
            <child>
              <object class="AdwPreferencesPage" id="ready_page">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>

                <!-- Group 1: Active Themes -->
                <child>
                  <object class="AdwPreferencesGroup" id="group_themes">
                    <property name="title" translatable="yes">Currently Active GNOME Themes</property>
                    <property name="description" translatable="yes">Current configuration read via GSettings.</property>
                    <child>
                      <object class="AdwActionRow" id="row_gtk_theme">
                        <property name="title" translatable="yes">GTK Theme (Applications)</property>
                        <property name="subtitle" translatable="yes">Not set</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">preferences-desktop-theme-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_icon_theme">
                        <property name="title" translatable="yes">Icon Theme</property>
                        <property name="subtitle" translatable="yes">Not set</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">applications-graphics-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_cursor_theme">
                        <property name="title" translatable="yes">Cursor Theme</property>
                        <property name="subtitle" translatable="yes">Not set</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">input-mouse-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_shell_theme">
                        <property name="title" translatable="yes">GNOME Shell Theme</property>
                        <property name="subtitle" translatable="yes">System Default</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">preferences-system-windows-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_color_scheme">
                        <property name="title" translatable="yes">Color Scheme</property>
                        <property name="subtitle" translatable="yes">Default</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">weather-clear-night-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Group 2: GTK4 / Libadwaita -->
                <child>
                  <object class="AdwPreferencesGroup" id="group_gtk4">
                    <property name="title" translatable="yes">GTK4 / Libadwaita</property>
                    <property name="description" translatable="yes">Compatibility with modern GNOME applications.</property>
                    <child>
                      <object class="AdwActionRow" id="row_gtk4_override">
                        <property name="title" translatable="yes">GTK4 Override Status</property>
                        <property name="subtitle" translatable="yes">Not available (applied during theme switch)</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">system-run-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Group 3: Desktop Environment and Paths -->
                <child>
                  <object class="AdwPreferencesGroup" id="group_environment">
                    <property name="title" translatable="yes">Desktop Environment and Paths</property>
                    <property name="description" translatable="yes">GSettings status and user directories for installation.</property>
                    <child>
                      <object class="AdwActionRow" id="row_gsettings_status">
                        <property name="title" translatable="yes">GSettings / Gio</property>
                        <property name="subtitle" translatable="yes">Available</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">emblem-default-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_user_themes_path">
                        <property name="title" translatable="yes">User Themes Folder</property>
                        <property name="subtitle" translatable="yes">~/.local/share/themes</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">folder-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_user_icons_path">
                        <property name="title" translatable="yes">User Icons Folder</property>
                        <property name="subtitle" translatable="yes">~/.local/share/icons</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">folder-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Group 4: Sandbox (Flatpak and Snap) -->
                <child>
                  <object class="AdwPreferencesGroup" id="group_sandbox">
                    <property name="title" translatable="yes">Sandbox Integration (Snap &amp;amp; Flatpak)</property>
                    <property name="description" translatable="yes">Access status of isolated applications to desktop themes.</property>
                    <child>
                      <object class="AdwActionRow" id="row_flatpak_status">
                        <property name="title" translatable="yes">Flatpak</property>
                        <property name="subtitle" translatable="yes">Available</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">application-x-executable-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="row_snap_status">
                        <property name="title" translatable="yes">Snap</property>
                        <property name="subtitle" translatable="yes">Available</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">package-x-generic-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- 3. EMPTY State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">empty</property>
        <property name="child">
          <object class="AdwStatusPage" id="empty_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">dialog-information-symbolic</property>
            <property name="title" translatable="yes">No configuration found</property>
            <property name="description" translatable="yes">No active theme settings detected on the system.</property>
            <property name="child">
              <object class="GtkButton" id="empty_retry_button">
                <property name="label" translatable="yes">Reload</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <style>
                  <class name="pill"/>
                  <class name="suggested-action"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 4. ERROR State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">error</property>
        <property name="child">
          <object class="AdwStatusPage" id="error_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">dialog-error-symbolic</property>
            <property name="title" translatable="yes">Read error</property>
            <property name="description" translatable="yes">Unable to retrieve system status.</property>
            <property name="child">
              <object class="GtkButton" id="error_retry_button">
                <property name="label" translatable="yes">Retry</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <style>
                  <class name="pill"/>
                  <class name="suggested-action"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
