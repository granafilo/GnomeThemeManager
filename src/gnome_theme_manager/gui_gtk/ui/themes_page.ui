<?xml version="1.0" encoding="UTF-8"?>
<!-- Template dichiarativo per la pagina 'Esplora temi' con Card Tema Attivo e Lista Altri Temi (Fase 5.4.x) -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="GtkStack" id="page_root">
    <property name="transition-type">crossfade</property>
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>

    <!-- 1. Stato LOADING -->
    <child>
      <object class="GtkStackPage">
        <property name="name">loading</property>
        <property name="child">
          <object class="AdwStatusPage" id="loading_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">applications-graphics-symbolic</property>
            <property name="title">Caricamento temi in corso...</property>
            <property name="description">Scansione dei temi installati nelle cartelle di sistema e utente.</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="spinning">true</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
                <property name="margin-top">12</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 2. Stato READY -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkBox" id="ready_box">
            <property name="orientation">vertical</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>

            <!-- Area scrollabile principale contenente Card Attiva e Lista Disponibili -->
            <child>
              <object class="GtkScrolledWindow" id="themes_scrolled_window">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">860</property>
                    <property name="tightening-threshold">600</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">16</property>
                    <property name="margin-top">16</property>
                    <property name="margin-bottom">16</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">16</property>

                        <!-- Titolo Categoria -->
                        <child>
                          <object class="GtkLabel" id="category_title_label">
                            <property name="label">Temi</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="title-2"/>
                            </style>
                          </object>
                        </child>

                        <!-- Sezione 1: Card Tema Attualmente Applicato -->
                        <child>
                          <object class="AdwPreferencesGroup" id="active_theme_group">
                            <property name="title">Tema attivo</property>
                            <property name="description">Il tema attualmente in uso nell'ambiente desktop.</property>
                            <child>
                              <object class="AdwActionRow" id="active_theme_row">
                                <property name="title">Caricamento...</property>
                                <property name="subtitle">-</property>
                                <property name="subtitle-lines">2</property>
                                <child type="prefix">
                                  <object class="GtkImage" id="active_theme_icon">
                                    <property name="icon-name">preferences-desktop-theme-symbolic</property>
                                    <property name="pixel-size">32</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="active_theme_badge">
                                    <property name="label">In uso</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="accent"/>
                                      <class name="heading"/>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Sezione 2: Lista Altri Temi Disponibili con Barra di Ricerca -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>

                            <!-- Intestazione sezione altri temi con ricerca -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkLabel" id="available_section_title">
                                    <property name="label">Altri temi disponibili</property>
                                    <property name="xalign">0</property>
                                    <property name="hexpand">true</property>
                                    <style>
                                      <class name="title-3"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSearchEntry" id="search_entry">
                                    <property name="placeholder-text">Cerca tra i temi disponibili...</property>
                                    <property name="width-request">260</property>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <!-- Conteggio risultati -->
                            <child>
                              <object class="GtkLabel" id="count_label">
                                <property name="xalign">0</property>
                                <style>
                                  <class name="dim-label"/>
                                </style>
                              </object>
                            </child>

                            <!-- Lista temi disponibili a selezione singola (esclude il tema attivo) -->
                            <child>
                              <object class="GtkListBox" id="themes_list_box">
                                <property name="selection-mode">single</property>
                                <property name="activate-on-single-click">false</property>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                              </object>
                            </child>

                            <!-- Stato 'Nessun risultato' per la ricerca o nessun altro tema -->
                            <child>
                              <object class="AdwStatusPage" id="no_results_page">
                                <property name="visible">false</property>
                                <property name="icon-name">system-search-symbolic</property>
                                <property name="title">Nessun altro tema disponibile</property>
                                <property name="description">Non sono stati trovati altri temi compatibili per questa categoria.</property>
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Barra d'azione inferiore per l'applicazione -->
            <child>
              <object class="AdwClamp">
                <property name="maximum-size">860</property>
                <property name="tightening-threshold">600</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">16</property>
                <property name="child">
                  <object class="GtkBox" id="action_box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkLabel" id="selection_info_label">
                        <property name="label">Seleziona un tema dall'elenco per applicarlo</property>
                        <property name="xalign">0</property>
                        <property name="hexpand">true</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="caption"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="apply_button">
                        <property name="label">Applica</property>
                        <property name="sensitive">false</property>
                        <property name="halign">end</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="suggested-action"/>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- 3. Stato EMPTY -->
    <child>
      <object class="GtkStackPage">
        <property name="name">empty</property>
        <property name="child">
          <object class="AdwStatusPage" id="empty_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">applications-graphics-symbolic</property>
            <property name="title">Nessun tema installato</property>
            <property name="description">Non è stato trovato alcun tema in questa categoria.</property>
            <property name="child">
              <object class="GtkButton" id="empty_refresh_button">
                <property name="label">Ricarica</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <style>
                  <class name="pill"/>
                  <class name="suggested-action"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 4. Stato ERROR -->
    <child>
      <object class="GtkStackPage">
        <property name="name">error</property>
        <property name="child">
          <object class="AdwStatusPage" id="error_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">dialog-error-symbolic</property>
            <property name="title">Errore durante la scansione</property>
            <property name="description">Si è verificato un errore durante il recupero dei temi dal filesystem.</property>
            <property name="child">
              <object class="GtkButton" id="error_retry_button">
                <property name="label">Riprova</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <style>
                  <class name="pill"/>
                  <class name="suggested-action"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
