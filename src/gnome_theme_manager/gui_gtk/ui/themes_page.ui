<!-- Declarative template for 'Browse Themes' page with Active Theme Card and Other Themes List -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="GtkStack" id="page_root">
    <property name="transition-type">crossfade</property>
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>

    <!-- 1. LOADING State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">loading</property>
        <property name="child">
          <object class="AdwStatusPage" id="loading_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">applications-graphics-symbolic</property>
            <property name="title" translatable="yes">Loading themes...</property>
            <property name="description" translatable="yes">Scanning installed themes across system and user directories.</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="spinning">true</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
                <property name="margin-top">12</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 2. READY State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkBox" id="ready_box">
            <property name="orientation">vertical</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>

            <!-- Main scrollable area containing Active Card and Available List -->
            <child>
              <object class="GtkScrolledWindow" id="themes_scrolled_window">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">860</property>
                    <property name="tightening-threshold">600</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">16</property>
                    <property name="margin-top">16</property>
                    <property name="margin-bottom">16</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">16</property>

                        <!-- Category Title -->
                        <child>
                          <object class="GtkLabel" id="category_title_label">
                            <property name="label" translatable="yes">Themes</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="title-2"/>
                            </style>
                          </object>
                        </child>

                        <!-- Section 1: Currently Active Theme Card -->
                        <child>
                          <object class="AdwPreferencesGroup" id="active_theme_group">
                            <property name="title" translatable="yes">Active Theme</property>
                            <property name="description" translatable="yes">The theme currently in use on the desktop environment.</property>
                            <child>
                              <object class="AdwActionRow" id="active_theme_row">
                                <property name="title" translatable="yes">Loading...</property>
                                <property name="subtitle" translatable="yes">-</property>
                                <property name="subtitle-lines">2</property>
                                <child type="prefix">
                                  <object class="GtkImage" id="active_theme_icon">
                                    <property name="icon-name">preferences-desktop-theme-symbolic</property>
                                    <property name="pixel-size">32</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="active_theme_badge">
                                    <property name="label" translatable="yes">In use</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="accent"/>
                                      <class name="heading"/>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Section 2: Other Available Themes List with Search Bar -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>

                            <!-- Section header with search -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkLabel" id="available_section_title">
                                    <property name="label" translatable="yes">Other available themes</property>
                                    <property name="xalign">0</property>
                                    <property name="hexpand">true</property>
                                    <style>
                                      <class name="title-3"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSearchEntry" id="search_entry">
                                    <property name="placeholder-text" translatable="yes">Search available themes...</property>
                                    <property name="width-request">260</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="system_themes_toggle">
                                    <property name="label" translatable="yes">Hide system themes</property>
                                    <property name="valign">center</property>
                                    <property name="active">false</property>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <!-- Count label -->
                            <child>
                              <object class="GtkLabel" id="count_label">
                                <property name="xalign">0</property>
                                <style>
                                  <class name="dim-label"/>
                                </style>
                              </object>
                            </child>

                            <!-- Available themes list box -->
                            <child>
                              <object class="GtkListBox" id="themes_list_box">
                                <property name="selection-mode">single</property>
                                <property name="activate-on-single-click">false</property>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                              </object>
                            </child>

                            <!-- No results status page -->
                            <child>
                              <object class="AdwStatusPage" id="no_results_page">
                                <property name="visible">false</property>
                                <property name="icon-name">system-search-symbolic</property>
                                <property name="title" translatable="yes">No other themes available</property>
                                <property name="description" translatable="yes">No other compatible themes found for this category.</property>
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Bottom action bar -->
            <child>
              <object class="AdwClamp">
                <property name="maximum-size">860</property>
                <property name="tightening-threshold">600</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">16</property>
                <property name="child">
                  <object class="GtkBox" id="action_box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkLabel" id="selection_info_label">
                        <property name="label" translatable="yes">Select a theme from the list to apply it</property>
                        <property name="xalign">0</property>
                        <property name="hexpand">true</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="caption"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="apply_button">
                        <property name="label" translatable="yes">Apply</property>
                        <property name="sensitive">false</property>
                        <property name="halign">end</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="suggested-action"/>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- 3. EMPTY State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">empty</property>
        <property name="child">
          <object class="AdwStatusPage" id="empty_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">applications-graphics-symbolic</property>
            <property name="title" translatable="yes">No themes installed</property>
            <property name="description" translatable="yes">No themes found in this category.</property>
            <property name="child">
              <object class="GtkButton" id="empty_refresh_button">
                <property name="label" translatable="yes">Reload</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <style>
                  <class name="pill"/>
                  <class name="suggested-action"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 4. ERROR State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">error</property>
        <property name="child">
          <object class="AdwStatusPage" id="error_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">dialog-error-symbolic</property>
            <property name="title" translatable="yes">Scan error</property>
            <property name="description" translatable="yes">An error occurred while retrieving themes from the filesystem.</property>
            <property name="child">
              <object class="GtkButton" id="error_retry_button">
                <property name="label" translatable="yes">Retry</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <style>
                  <class name="pill"/>
                  <class name="suggested-action"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
