<!-- Template dichiarativo per la pagina 'Strumenti sandbox' (Fase 5.8) -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="GtkStack" id="page_root">
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>
    <property name="transition-type">crossfade</property>

    <!-- ================================================================= -->
    <!-- 1. STATO LOADING: Spinner di caricamento diagnostica              -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">loading</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkSpinner" id="loading_spinner">
                <property name="spinning">true</property>
                <property name="width-request">48</property>
                <property name="height-request">48</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="loading_label">
                <property name="label" translatable="yes">Verifica dello stato sandbox in corso…</property>
                <style>
                  <class name="title-3"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Interrogazione dei runtime Flatpak e Snap</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 2. STATO READY: Diagnostica Flatpak/Snap e azioni di propagazione  -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">680</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>

                    <!-- GRUPPO FLATPAK -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Ambiente Flatpak</property>
                        <property name="description" translatable="yes">Integrazione dei permessi e accesso ai temi per le applicazioni Flatpak.</property>
                        <child>
                          <object class="AdwActionRow" id="flatpak_status_row">
                            <property name="title" translatable="yes">Stato Flatpak</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="flatpak_status_icon">
                                <property name="icon-name">package-x-generic-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="flatpak_override_row">
                            <property name="title" translatable="yes">Override filesystem temi</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="flatpak_override_icon">
                                <property name="icon-name">folder-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="flatpak_notes_row">
                            <property name="title" translatable="yes">Note di compatibilità</property>
                            <property name="subtitle" translatable="yes">L'override utente consente l'accesso in sola lettura a ~/.local/share/themes e icone.</property>
                            <child type="prefix">
                              <object class="GtkImage" id="flatpak_notes_icon">
                                <property name="icon-name">dialog-information-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- GRUPPO SNAP -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Ambiente Snap</property>
                        <property name="description" translatable="yes">Integrazione con il framework dei temi e snap standard di sistema.</property>
                        <child>
                          <object class="AdwActionRow" id="snap_status_row">
                            <property name="title" translatable="yes">Stato Snap</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_status_icon">
                                <property name="icon-name">package-x-generic-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_gtk_common_row">
                            <property name="title" translatable="yes">Pacchetto gtk-common-themes</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_gtk_common_icon">
                                <property name="icon-name">emblem-default-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_theme_compat_row">
                            <property name="title" translatable="yes">Compatibilità tema attivo</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_theme_compat_icon">
                                <property name="icon-name">preferences-desktop-theme-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_notes_row">
                            <property name="title" translatable="yes">Note di compatibilità</property>
                            <property name="subtitle" translatable="yes">Le app Snap usano i temi inclusi in gtk-common-themes. Temi personalizzati richiedono snap dedicati.</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_notes_icon">
                                <property name="icon-name">dialog-information-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- CONTROLLI E AZIONI -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="GtkButton" id="refresh_button">
                            <property name="label" translatable="yes">Ricarica stato</property>
                            <property name="tooltip-text" translatable="yes">Aggiorna la diagnostica dei runtime sandbox</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="propagate_button">
                            <property name="label" translatable="yes">Propaga tema alle applicazioni sandbox</property>
                            <property name="tooltip-text" translatable="yes">Configura gli override Flatpak e verifica la compatibilità per i temi attivi</property>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 3. STATO ERROR: Errore durante il recupero diagnostico            -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">error</property>
        <property name="child">
          <object class="AdwStatusPage" id="error_status_page">
            <property name="icon-name">dialog-error-symbolic</property>
            <property name="title" translatable="yes">Errore diagnostica</property>
            <property name="description" translatable="yes">Impossibile verificare lo stato dei runtime sandbox.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <property name="halign">center</property>
                    <property name="margin-top">16</property>
                    <child>
                      <object class="GtkButton" id="error_retry_button">
                        <property name="label" translatable="yes">Riprova</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

  </object>
</interface>
