<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Declarative template for 'Sandbox Tools' page -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="GtkStack" id="page_root">
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>
    <property name="transition-type">crossfade</property>

    <!-- ================================================================= -->
    <!-- 1. LOADING STATE: Diagnostics loading spinner                     -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">loading</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkSpinner" id="loading_spinner">
                <property name="spinning">true</property>
                <property name="width-request">48</property>
                <property name="height-request">48</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="loading_label">
                <property name="label" translatable="yes">Checking sandbox status…</property>
                <style>
                  <class name="title-3"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Querying Flatpak and Snap runtimes</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 2. READY STATE: Flatpak/Snap diagnostics and propagation actions  -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">840</property>
                <property name="tightening-threshold">560</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>

                    <!-- ACTIVE CONFIGURATION GROUP -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Active Desktop Configuration</property>
                        <property name="description" translatable="yes">Themes currently configured in GNOME desktop settings.</property>
                        <child>
                          <object class="AdwActionRow" id="active_gtk_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">GTK / Application Theme</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="active_gtk_icon">
                                <property name="icon-name">preferences-desktop-theme-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="active_icon_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">Icon &amp;amp; Cursor Theme</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="active_icon_icon">
                                <property name="icon-name">emblem-photos-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- FLATPAK GROUP -->
                    <child>
                      <object class="AdwPreferencesGroup" id="flatpak_group">
                        <property name="title" translatable="yes">Flatpak Environment</property>
                        <property name="description" translatable="yes">Permission integration and theme access for Flatpak applications.</property>
                        <child>
                          <object class="AdwActionRow" id="flatpak_status_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">Flatpak Status</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="flatpak_status_icon">
                                <property name="icon-name">flatpak-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="flatpak_override_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">Theme Filesystem Override</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="flatpak_override_icon">
                                <property name="icon-name">folder-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="flatpak_notes_row">
                            <property name="subtitle-lines">3</property>
                            <property name="title" translatable="yes">Compatibility Notes</property>
                            <property name="subtitle" translatable="yes">User overrides grant read-only access to ~/.local/share/themes and icons.</property>
                            <child type="prefix">
                              <object class="GtkImage" id="flatpak_notes_icon">
                                <property name="icon-name">dialog-information-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- SNAP GROUP -->
                    <child>
                      <object class="AdwPreferencesGroup" id="snap_group">
                        <property name="title" translatable="yes">Snap Environment</property>
                        <property name="description" translatable="yes">Integration with theme framework and standard system snaps.</property>
                        <child>
                          <object class="AdwActionRow" id="snap_status_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">Snap Status</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_status_icon">
                                <property name="icon-name">package-x-generic-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_gtk_common_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">gtk-common-themes Package</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_gtk_common_icon">
                                <property name="icon-name">emblem-default-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_theme_compat_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">Active Theme Compatibility</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_theme_compat_icon">
                                <property name="icon-name">preferences-desktop-theme-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_installed_content_row">
                            <property name="subtitle-lines">2</property>
                            <property name="title" translatable="yes">Installed Content Snap</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_installed_content_icon">
                                <property name="icon-name">starred-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_connected_apps_row">
                            <property name="subtitle-lines">3</property>
                            <property name="title" translatable="yes">Connected Snap Applications</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_connected_apps_icon">
                                <property name="icon-name">emblem-ok-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_build_custom_row">
                            <property name="subtitle-lines">3</property>
                            <property name="title" translatable="yes">Custom Theme Snap</property>
                            <property name="subtitle" translatable="yes">Generate and connect a local Content Snap to allow Snap apps to use this custom theme.</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_build_custom_icon">
                                <property name="icon-name">applications-engineering-symbolic</property>
                              </object>
                            </child>
                            <child type="suffix">
                              <object class="GtkButton" id="snap_build_custom_button">
                                <property name="label" translatable="yes">Build Snap</property>
                                <property name="tooltip-text" translatable="yes">Generate local Content Snap and connect to all compatible Snap apps</property>
                                <property name="valign">center</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="snap_notes_row">
                            <property name="subtitle-lines">3</property>
                            <property name="title" translatable="yes">Compatibility Notes</property>
                            <property name="subtitle" translatable="yes">Snap apps use themes bundled in gtk-common-themes or local Content Snaps generated for custom themes.</property>
                            <child type="prefix">
                              <object class="GtkImage" id="snap_notes_icon">
                                <property name="icon-name">dialog-information-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- CONTROLS AND ACTIONS -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="GtkButton" id="sandbox_help_button">
                            <property name="label" translatable="yes">Sandbox Guide</property>
                            <property name="tooltip-text" translatable="yes">How to enable and troubleshoot Flatpak and Snap theme integration</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="refresh_button">
                            <property name="label" translatable="yes">Reload</property>
                            <property name="tooltip-text" translatable="yes">Update sandbox runtime diagnostics</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="propagate_button">
                            <property name="label" translatable="yes">Propagate Themes</property>
                            <property name="tooltip-text" translatable="yes">Configure Flatpak overrides and verify compatibility for active themes</property>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 3. ERROR STATE: Error retrieving diagnostics                      -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">error</property>
        <property name="child">
          <object class="AdwStatusPage" id="error_status_page">
            <property name="icon-name">dialog-error-symbolic</property>
            <property name="title" translatable="yes">Diagnostic Error</property>
            <property name="description" translatable="yes">Unable to verify sandbox runtimes status.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <property name="halign">center</property>
                    <property name="margin-top">16</property>
                    <child>
                      <object class="GtkButton" id="error_retry_button">
                        <property name="label" translatable="yes">Retry</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

  </object>
</interface>
