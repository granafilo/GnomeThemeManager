<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Declarative template for 'Theme Installer' page -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="GtkStack" id="page_root">
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>
    <property name="transition-type">crossfade</property>

    <!-- ================================================================= -->
    <!-- 1. INITIAL STATE: Prompt to choose folder or archive              -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">initial</property>
        <property name="child">
          <object class="AdwStatusPage" id="initial_status_page">
            <property name="icon-name">system-software-install-symbolic</property>
            <property name="title" translatable="yes">Theme Installer</property>
            <property name="description" translatable="yes">Select a folder or compressed archive (.zip, .tar.gz, .tar.xz) to install new themes.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">16</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="margin-top">24</property>
                    <child>
                      <object class="GtkButton" id="select_folder_button">
                        <property name="label" translatable="yes">Select Folder</property>
                        <property name="tooltip-text" translatable="yes">Select an extracted theme folder on the filesystem</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="select_archive_button">
                        <property name="label" translatable="yes">Select Archive</property>
                        <property name="tooltip-text" translatable="yes">Select a compressed archive file (.zip, .tar.gz, .tar.xz, .tar.bz2)</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 2. ANALYZING STATE: Spinner and source inspection indicator        -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">analyzing</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkSpinner" id="analyzing_spinner">
                <property name="spinning">true</property>
                <property name="width-request">48</property>
                <property name="height-request">48</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="analyzing_label">
                <property name="label" translatable="yes">Analyzing source…</property>
                <style>
                  <class name="title-3"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Security verification and component detection</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 3. READY STATE: Detected theme details and action buttons         -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">600</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Source Details</property>
                        <property name="description" translatable="yes">Detected theme information from selected source.</property>
                        <child>
                          <object class="AdwActionRow" id="source_name_row">
                            <property name="title" translatable="yes">Selected Source</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">folder-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="source_type_row">
                            <property name="title" translatable="yes">Source Type</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">dialog-information-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="detected_theme_name_row">
                            <property name="title" translatable="yes">Detected Theme Name</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">preferences-desktop-theme-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="detected_components_row">
                            <property name="title" translatable="yes">Supported Components</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">emblem-default-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="validation_status_row">
                            <property name="title" translatable="yes">Validation Status</property>
                            <property name="subtitle" translatable="yes">Valid</property>
                            <child type="prefix">
                              <object class="GtkImage" id="validation_status_icon">
                                <property name="icon-name">emblem-ok-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="target_dir_row">
                            <property name="title" translatable="yes">Install into legacy path ~/.themes and ~/.icons</property>
                            <property name="subtitle" translatable="yes">If disabled, uses XDG standard (~/.local/share/themes)</property>
                            <property name="icon-name">folder-remote-symbolic</property>
                            <child>
                              <object class="GtkSwitch" id="target_dir_switch">
                                <property name="valign">center</property>
                                <property name="active">false</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <property name="margin-top">8</property>
                        <child>
                          <object class="GtkButton" id="change_source_button">
                            <property name="label" translatable="yes">Change Source</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="install_button">
                            <property name="label" translatable="yes">Install</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="install_apply_button">
                            <property name="label" translatable="yes">Install and Apply</property>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 4. INSTALLING STATE: Spinner and installation progress            -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">installing</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkSpinner" id="installing_spinner">
                <property name="spinning">true</property>
                <property name="width-request">48</property>
                <property name="height-request">48</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="installing_status_label">
                <property name="label" translatable="yes">Installing theme…</property>
                <style>
                  <class name="title-3"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Copying files into XDG user directories</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 5. SUCCESS STATE: Confirmation and action for new operation       -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">success</property>
        <property name="child">
          <object class="AdwStatusPage" id="success_status_page">
            <property name="icon-name">emblem-ok-symbolic</property>
            <property name="title" translatable="yes">Installation Completed</property>
            <property name="description" translatable="yes">The theme was successfully installed in user directories.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="halign">center</property>
                    <property name="margin-top">16</property>
                    <child>
                      <object class="GtkButton" id="success_new_source_button">
                        <property name="label" translatable="yes">Select Another Source</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 6. ERROR STATE: Error message, retry button and reset             -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">error</property>
        <property name="child">
          <object class="AdwStatusPage" id="error_status_page">
            <property name="icon-name">dialog-error-symbolic</property>
            <property name="title" translatable="yes">Operation Error</property>
            <property name="description" translatable="yes">An error occurred during inspection or installation.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <property name="halign">center</property>
                    <property name="margin-top">16</property>
                    <child>
                      <object class="GtkButton" id="error_retry_button">
                        <property name="label" translatable="yes">Retry</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="error_new_source_button">
                        <property name="label" translatable="yes">Select Another Source</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

  </object>
</interface>
