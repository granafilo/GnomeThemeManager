<!-- Template dichiarativo per la pagina 'Installatore temi' (Fase 5.7) -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="GtkStack" id="page_root">
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>
    <property name="transition-type">crossfade</property>

    <!-- ================================================================= -->
    <!-- 1. STATO INITIAL: Invito alla selezione di cartella o archivio    -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">initial</property>
        <property name="child">
          <object class="AdwStatusPage" id="initial_status_page">
            <property name="icon-name">system-software-install-symbolic</property>
            <property name="title" translatable="yes">Installatore temi</property>
            <property name="description" translatable="yes">Seleziona una cartella o un archivio compresso (.zip, .tar.gz, .tar.xz) per installare nuovi temi.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">16</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="margin-top">24</property>
                    <child>
                      <object class="GtkButton" id="select_folder_button">
                        <property name="label" translatable="yes">Seleziona cartella</property>
                        <property name="tooltip-text" translatable="yes">Seleziona una cartella di tema già estratta sul filesystem</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="select_archive_button">
                        <property name="label" translatable="yes">Seleziona archivio</property>
                        <property name="tooltip-text" translatable="yes">Seleziona un file compresso (.zip, .tar.gz, .tar.xz, .tar.bz2)</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 2. STATO ANALYZING: Spinner e indicatore di analisi sorgente      -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">analyzing</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkSpinner" id="analyzing_spinner">
                <property name="spinning">true</property>
                <property name="width-request">48</property>
                <property name="height-request">48</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="analyzing_label">
                <property name="label" translatable="yes">Analisi della sorgente in corso…</property>
                <style>
                  <class name="title-3"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Verifica di sicurezza ed estrazione componenti</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 3. STATO READY: Dettagli tema rilevato e pulsanti di azione       -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">600</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Dettagli sorgente</property>
                        <property name="description" translatable="yes">Informazioni sul tema rilevato nella sorgente selezionata.</property>
                        <child>
                          <object class="AdwActionRow" id="source_name_row">
                            <property name="title" translatable="yes">Sorgente selezionata</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">folder-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="source_type_row">
                            <property name="title" translatable="yes">Tipo sorgente</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">dialog-information-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="detected_theme_name_row">
                            <property name="title" translatable="yes">Nome tema rilevato</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">preferences-desktop-theme-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="detected_components_row">
                            <property name="title" translatable="yes">Componenti supportati</property>
                            <property name="subtitle" translatable="yes">-</property>
                            <property name="icon-name">emblem-default-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="target_dir_row">
                            <property name="title" translatable="yes">Installa nel percorso legacy ~/.themes e ~/.icons</property>
                            <property name="subtitle" translatable="yes">Se disattivato, usa lo standard XDG (~/.local/share/themes)</property>
                            <property name="icon-name">folder-remote-symbolic</property>
                            <child>
                              <object class="GtkSwitch" id="target_dir_switch">
                                <property name="valign">center</property>
                                <property name="active">false</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <property name="margin-top">8</property>
                        <child>
                          <object class="GtkButton" id="change_source_button">
                            <property name="label" translatable="yes">Cambia sorgente</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="install_button">
                            <property name="label" translatable="yes">Installa</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="install_apply_button">
                            <property name="label" translatable="yes">Installa e Applica</property>
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 4. STATO INSTALLING: Spinner e avanzamento installazione          -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">installing</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkSpinner" id="installing_spinner">
                <property name="spinning">true</property>
                <property name="width-request">48</property>
                <property name="height-request">48</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="installing_status_label">
                <property name="label" translatable="yes">Installazione del tema in corso…</property>
                <style>
                  <class name="title-3"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Copia dei file nelle cartelle utente XDG</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 5. STATO SUCCESS: Conferma e riepilogo con azione per nuova op    -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">success</property>
        <property name="child">
          <object class="AdwStatusPage" id="success_status_page">
            <property name="icon-name">emblem-ok-symbolic</property>
            <property name="title" translatable="yes">Installazione completata</property>
            <property name="description" translatable="yes">Il tema è stato installato con successo nelle directory utente.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="halign">center</property>
                    <property name="margin-top">16</property>
                    <child>
                      <object class="GtkButton" id="success_new_source_button">
                        <property name="label" translatable="yes">Seleziona un'altra sorgente</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- ================================================================= -->
    <!-- 6. STATO ERROR: Messaggio di errore, pulsante Riprova e Reset     -->
    <!-- ================================================================= -->
    <child>
      <object class="GtkStackPage">
        <property name="name">error</property>
        <property name="child">
          <object class="AdwStatusPage" id="error_status_page">
            <property name="icon-name">dialog-error-symbolic</property>
            <property name="title" translatable="yes">Errore durante l'operazione</property>
            <property name="description" translatable="yes">Si è verificato un errore durante l'analisi o l'installazione.</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <property name="halign">center</property>
                    <property name="margin-top">16</property>
                    <child>
                      <object class="GtkButton" id="error_retry_button">
                        <property name="label" translatable="yes">Riprova</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="error_new_source_button">
                        <property name="label" translatable="yes">Seleziona un'altra sorgente</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

  </object>
</interface>
