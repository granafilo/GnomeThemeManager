<!-- Declarative template for 'Theme Editor' page -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="GtkStack" id="page_root">
    <property name="transition-type">crossfade</property>
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>

    <!-- 1. LOADING State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">loading</property>
        <property name="child">
          <object class="AdwStatusPage" id="loading_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">preferences-color-symbolic</property>
            <property name="title" translatable="yes">Loading Theme Editor...</property>
            <property name="description" translatable="yes">Discovering installed components and extracting colors.</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="spinning">true</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
                <property name="margin-top">12</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 2. READY State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkScrolledWindow" id="scrolled_window">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">1000</property>
                <property name="tightening-threshold">700</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="child">
                  <object class="GtkBox" id="ready_main_box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>

                    <!-- Page Header -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Theme Editor &amp; Mixer</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="title-1"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Mix installed components, customize GTK colors, preview live, and save as a custom Global Theme.</property>
                            <property name="xalign">0</property>
                            <property name="wrap">true</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Preview Status Banner -->
                    <child>
                      <object class="AdwBanner" id="preview_banner">
                        <property name="title" translatable="yes">👁️ Live Desktop Preview Active</property>
                        <property name="button-label" translatable="yes">Stop Preview</property>
                        <property name="revealed">false</property>
                      </object>
                    </child>

                    <!-- Unsaved Draft Prompt Box / Banner -->
                    <child>
                      <object class="GtkBox" id="draft_banner_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <property name="visible">false</property>
                        <style>
                          <class name="card"/>
                          <class name="accent"/>
                        </style>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">document-edit-symbolic</property>
                            <property name="margin-start">12</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Unfinished draft found. Would you like to resume it?</property>
                            <property name="hexpand">true</property>
                            <property name="xalign">0</property>
                            <property name="margin-top">8</property>
                            <property name="margin-bottom">8</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="resume_draft_button">
                            <property name="label" translatable="yes">Resume Draft</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="discard_draft_button">
                            <property name="label" translatable="yes">Discard Draft</property>
                            <property name="tooltip-text" translatable="yes">Delete saved draft and reset editor</property>
                            <property name="valign">center</property>
                            <property name="margin-end">12</property>
                            <style>
                              <class name="destructive-action"/>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Action Bar Top -->
                    <child>
                      <object class="GtkBox" id="action_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkEntry" id="theme_name_entry">
                            <property name="placeholder-text" translatable="yes">Custom Theme Name...</property>
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="save_as_global_theme_button">
                            <property name="tooltip-text" translatable="yes">Save current editor mix as a Global Theme</property>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">document-save-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Save as Global Theme</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="preview_button">
                            <property name="tooltip-text" translatable="yes">Live test theme components and colors with safety rollback</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage" id="preview_button_icon">
                                    <property name="icon-name">camera-photo-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="preview_button_label">
                                    <property name="label" translatable="yes">Preview</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Section 1: Components Mixer -->
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Component Mixer</property>
                        <property name="description" translatable="yes">Select individual components from installed desktop themes</property>
                        <child>
                          <object class="AdwComboRow" id="dropdown_gtk">
                            <property name="title" translatable="yes">GTK Theme (Applications)</property>
                            <property name="subtitle" translatable="yes">Controls window background, widgets, and GTK3/GTK4 styling</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="dropdown_shell">
                            <property name="title" translatable="yes">GNOME Shell Theme</property>
                            <property name="subtitle" translatable="yes">Controls panel, dash, notification popups, and lockscreen</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="dropdown_icon">
                            <property name="title" translatable="yes">Icon Pack</property>
                            <property name="subtitle" translatable="yes">Application icons, folder icons, and file type symbols</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="dropdown_cursor">
                            <property name="title" translatable="yes">Cursor Theme</property>
                            <property name="subtitle" translatable="yes">Mouse pointer and interaction animations</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="dropdown_color_scheme">
                            <property name="title" translatable="yes">Color Scheme Preference</property>
                            <property name="subtitle" translatable="yes">System dark/light mode preference</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Section 2: Adaptive Wallpaper Colors -->
                    <child>
                      <object class="AdwPreferencesGroup" id="wallpaper_customization_group">
                        <property name="title" translatable="yes">Wallpaper Colors</property>
                        <property name="description" translatable="yes">Extract dominant adaptive colors from desktop wallpaper and apply them globally to GTK and GNOME Shell</property>
                        <property name="header-suffix">
                          <object class="GtkButton" id="wallpaper_colors_button">
                            <property name="tooltip-text" translatable="yes">Extract dominant adaptive color palette from current desktop wallpaper</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">preferences-desktop-wallpaper-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Extract from Wallpaper</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>

                        <!-- Wallpaper Palette Swatches Row -->
                        <child>
                          <object class="AdwActionRow" id="row_wallpaper_palette">
                            <property name="title" translatable="yes">Adaptive Wallpaper Palette</property>
                            <property name="subtitle" translatable="yes">Click a swatch to apply as Accent color for both GTK and Shell</property>
                            <child type="suffix">
                              <object class="GtkBox" id="wallpaper_palette_container">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Section 3: GNOME Shell Color Customization -->
                    <child>
                      <object class="AdwPreferencesGroup" id="shell_color_customization_group">
                        <property name="title" translatable="yes">GNOME Shell Colors</property>
                        <property name="description" translatable="yes">Fine-tune panel, text, overview, and accent colors for GNOME Shell (User Themes extension required)</property>
                        <property name="header-suffix">
                          <object class="GtkButton" id="reset_shell_colors_button">
                            <property name="tooltip-text" translatable="yes">Restore GNOME Shell colors to original theme defaults</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">edit-undo-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Reset Shell Colors</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>

                        <child>
                          <object class="AdwActionRow" id="row_shell_panel_bg">
                            <property name="title" translatable="yes">Panel Background</property>
                            <property name="subtitle" translatable="yes">#panel { background-color: ... }</property>
                            <child type="suffix">
                              <object class="GtkBox" id="shell_panel_bg_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="row_shell_panel_fg">
                            <property name="title" translatable="yes">Panel Text and Icons</property>
                            <property name="subtitle" translatable="yes">#panel, .panel-button { color: ... }</property>
                            <child type="suffix">
                              <object class="GtkBox" id="shell_panel_fg_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="row_shell_overview_bg">
                            <property name="title" translatable="yes">Overview Background</property>
                            <property name="subtitle" translatable="yes">.overview { background-color: ... }</property>
                            <child type="suffix">
                              <object class="GtkBox" id="shell_overview_bg_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="row_shell_accent">
                            <property name="title" translatable="yes">Shell Accent / Selection</property>
                            <property name="subtitle" translatable="yes">.popup-menu-item:selected { background-color: ... }</property>
                            <child type="suffix">
                              <object class="GtkBox" id="shell_accent_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </child>

                    <!-- Section 4: GTK Theme Color Customization -->
                    <child>
                      <object class="AdwPreferencesGroup" id="color_customization_group">
                        <property name="title" translatable="yes">GTK Theme Colors</property>
                        <property name="description" translatable="yes">Fine-tune foreground, background, and accent colors for GTK applications</property>
                        <property name="header-suffix">
                          <object class="GtkButton" id="reset_colors_button">
                            <property name="tooltip-text" translatable="yes">Restore GTK colors to original theme defaults</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">edit-undo-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Reset GTK Colors</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>

                        <child>
                          <object class="AdwActionRow" id="row_fg_color">
                            <property name="title" translatable="yes">Foreground / Text Color</property>
                            <property name="subtitle" translatable="yes">@define-color theme_fg_color</property>
                            <child type="suffix">
                              <object class="GtkBox" id="fg_color_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="row_bg_color">
                            <property name="title" translatable="yes">Background / Window Color</property>
                            <property name="subtitle" translatable="yes">@define-color theme_bg_color</property>
                            <child type="suffix">
                              <object class="GtkBox" id="bg_color_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="row_accent_color">
                            <property name="title" translatable="yes">Accent / Selection Color</property>
                            <property name="subtitle" translatable="yes">@define-color theme_selected_bg_color</property>
                            <child type="suffix">
                              <object class="GtkBox" id="accent_color_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwActionRow" id="row_accent_fg_color">
                            <property name="title" translatable="yes">Accent Text Color</property>
                            <property name="subtitle" translatable="yes">@define-color theme_selected_fg_color</property>
                            <child type="suffix">
                              <object class="GtkBox" id="accent_fg_color_container">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </child>

                    <!-- Section 5: Draft Settings -->
                    <child>
                      <object class="AdwPreferencesGroup" id="draft_settings_group">
                        <property name="title" translatable="yes">Draft Settings</property>
                        <child>
                          <object class="AdwActionRow" id="row_auto_save_draft">
                            <property name="title" translatable="yes">Auto-save Draft</property>
                            <property name="subtitle" translatable="yes">Automatically preserve unfinished editor work across app restarts</property>
                            <property name="activatable-widget">auto_save_draft_switch</property>
                            <child type="suffix">
                              <object class="GtkSwitch" id="auto_save_draft_switch">
                                <property name="active">true</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

  </object>
</interface>
