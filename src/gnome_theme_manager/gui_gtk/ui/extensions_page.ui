<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <object class="GtkStack" id="page_root">
    <property name="transition-type">none</property>
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>

    <!-- 1. LOADING State (Full Page AdwStatusPage) -->
    <child>
      <object class="GtkStackPage">
        <property name="name">loading</property>
        <property name="child">
          <object class="AdwStatusPage" id="loading_page">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="icon-name">application-x-addon-symbolic</property>
            <property name="title" translatable="yes">Loading extensions...</property>
            <property name="description" translatable="yes">Scanning installed extensions across system and user directories.</property>
            <style>
              <class name="solid-loading-page"/>
              <class name="background"/>
            </style>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="spinning">true</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
                <property name="margin-top">12</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- 2. READY State -->
    <child>
      <object class="GtkStackPage">
        <property name="name">ready</property>
        <property name="child">
          <object class="GtkBox" id="ready_box">
            <property name="orientation">vertical</property>
            <property name="spacing">0</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <style>
              <class name="background"/>
            </style>

            <child>
              <object class="GtkScrolledWindow" id="scrolled_window">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="hscrollbar-policy">never</property>

                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">960</property>
                    <property name="tightening-threshold">600</property>

                    <property name="child">
                      <object class="GtkBox" id="main_content_box">
                        <property name="orientation">vertical</property>
                        <property name="spacing">20</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">16</property>
                        <property name="margin-end">16</property>

                        <!-- Page Header Card / Banner -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">16</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">application-x-addon-symbolic</property>
                                <property name="pixel-size">48</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">4</property>
                                <property name="hexpand">true</property>
                                <child>
                                  <object class="GtkLabel" id="header_title">
                                    <property name="label" translatable="yes">GNOME Extensions</property>
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="title-1"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="header_subtitle">
                                    <property name="label" translatable="yes">Manage, enable, and inspect installed GNOME Shell extensions.</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap">true</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="body"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkButton" id="btn_open_app">
                                    <property name="label" translatable="yes">Open Extension Manager</property>
                                    <property name="tooltip-text" translatable="yes">Open GNOME Extensions application to manage installed extensions</property>
                                    <property name="accessible-role">button</property>
                                    <style>
                                      <class name="suggested-action"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="btn_browse_portal">
                                    <property name="icon-name">web-browser-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Open official GNOME Extensions website</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Banner: Install Extension Manager if not present -->
                        <child>
                          <object class="AdwBanner" id="install_banner">
                            <property name="revealed">false</property>
                            <property name="title" translatable="yes">Extension Manager is not installed.</property>
                            <property name="button-label" translatable="yes">Copy Command</property>
                          </object>
                        </child>

                        <!-- Installation Options Group -->
                        <child>
                          <object class="AdwPreferencesGroup" id="group_install_manager">
                            <property name="title" translatable="yes">Extension Manager</property>
                            <property name="description" translatable="yes">Options and commands to install or manage GNOME Extension Manager.</property>
                            <child>
                              <object class="AdwExpanderRow" id="expander_install_options">
                                <property name="title" translatable="yes">Installation Options</property>
                                <property name="subtitle" translatable="yes">View installation commands for Flatpak or system packages</property>
                                <property name="expanded">false</property>
                                <child>
                                  <object class="AdwComboRow" id="combo_install_method">
                                    <property name="title" translatable="yes">Installation Method</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="row_install_command">
                                    <property name="title" translatable="yes">Terminal Command</property>
                                    <property name="subtitle-selectable">true</property>
                                    <child>
                                      <object class="GtkButton" id="btn_copy_install_command">
                                        <property name="icon-name">edit-copy-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Copy installation command</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="row_basic_app">
                                    <property name="title" translatable="yes">GNOME Extensions (Basic)</property>
                                    <property name="subtitle" translatable="yes">Launch standard GNOME Extensions utility</property>
                                    <property name="visible">false</property>
                                    <child>
                                      <object class="GtkButton" id="btn_open_basic_app">
                                        <property name="label" translatable="yes">Open</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Toolbar: Search, Filter Dropdown, Sort Dropdown & Refresh -->
                        <child>
                          <object class="GtkBox" id="search_controls_box">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkSearchEntry" id="search_entry">
                                <property name="placeholder-text" translatable="yes">Search extensions...</property>
                                <property name="hexpand">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="filter_dropdown">
                                <property name="tooltip-text" translatable="yes">Filter extensions</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="sort_dropdown">
                                <property name="tooltip-text" translatable="yes">Sort extensions</property>
                                <property name="visible">false</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_refresh">
                                <property name="icon-name">view-refresh-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Refresh extension list</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <!-- Status Stack (Content Groups / Empty Search / Error / Searching) -->
                        <child>
                          <object class="GtkStack" id="status_stack">
                            <property name="transition-type">crossfade</property>
                            <property name="vexpand">true</property>

                            <!-- Page: Content Groups -->
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">content</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">24</property>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="user_extensions_group">
                                        <property name="title" translatable="yes">User Extensions</property>
                                        <property name="description" translatable="yes">Extensions installed in your user directory</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="system_extensions_group">
                                        <property name="title" translatable="yes">System and Built-in Extensions</property>
                                        <property name="description" translatable="yes">Integrated system extensions provided by GNOME Shell or system packages</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="remote_extensions_group">
                                        <property name="title" translatable="yes">Available Extensions</property>
                                        <property name="description" translatable="yes">Browse and install extensions from official catalog</property>
                                        <property name="visible">false</property>
                                      </object>
                                    </child>
                                    <!-- Lazy loading footer -->
                                    <child>
                                      <object class="GtkBox" id="lazy_load_box">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">8</property>
                                        <property name="halign">center</property>
                                        <property name="margin-top">8</property>
                                        <property name="margin-bottom">16</property>
                                        <property name="visible">false</property>
                                        <child>
                                          <object class="GtkSpinner" id="lazy_spinner">
                                            <property name="spinning">false</property>
                                            <property name="visible">false</property>
                                            <property name="width-request">24</property>
                                            <property name="height-request">24</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="btn_load_more">
                                            <property name="label" translatable="yes">Load more extensions...</property>
                                            <property name="visible">false</property>
                                            <style>
                                              <class name="pill"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <!-- Page: Searching state -->
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">searching</property>
                                <property name="child">
                                  <object class="AdwStatusPage" id="searching_status_page">
                                    <property name="icon-name">system-search-symbolic</property>
                                    <property name="title" translatable="yes">Searching extensions...</property>
                                    <property name="description" translatable="yes">Connecting to extensions catalog...</property>
                                    <property name="child">
                                      <object class="GtkSpinner" id="searching_spinner">
                                        <property name="spinning">true</property>
                                        <property name="halign">center</property>
                                        <property name="valign">center</property>
                                        <property name="width-request">32</property>
                                        <property name="height-request">32</property>
                                        <property name="margin-top">12</property>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <!-- Page: Empty Search -->
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">empty</property>
                                <property name="child">
                                  <object class="AdwStatusPage" id="empty_status_page">
                                    <property name="icon-name">application-x-addon-symbolic</property>
                                    <property name="title" translatable="yes">No Extensions Found</property>
                                    <property name="description" translatable="yes">No extensions matched your filter or none are installed.</property>
                                  </object>
                                </property>
                              </object>
                            </child>

                            <!-- Page: Network / Catalog Error -->
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">error</property>
                                <property name="child">
                                  <object class="AdwStatusPage" id="error_status_page">
                                    <property name="icon-name">network-offline-symbolic</property>
                                    <property name="title" translatable="yes">Catalog Unavailable</property>
                                    <property name="description" translatable="yes">Unable to query online extensions catalog. Check your internet connection.</property>
                                    <property name="child">
                                      <object class="GtkButton" id="btn_error_retry">
                                        <property name="label" translatable="yes">Retry</property>
                                        <property name="halign">center</property>
                                        <property name="margin-top">12</property>
                                        <style>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

  </object>
</interface>
