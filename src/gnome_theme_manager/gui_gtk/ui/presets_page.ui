<?xml version="1.0" encoding="UTF-8"?>
<!-- Template dichiarativo per la pagina 'Profili e preset' (Fase 5.2.1) -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="page_root">
    <property name="vexpand">true</property>
    <property name="hexpand">true</property>
    <property name="icon-name">document-save-as-symbolic</property>
    <property name="title">Profili e preset</property>
    <property name="description">La gestione dei preset sarà collegata nella Fase 5.5.</property>
  </object>
</interface>
